<Window x:Class="OfficeAttendanceTracker.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Office Attendance Tracker" Width="1080" Height="720" MinWidth="900" MinHeight="670"
        WindowStartupLocation="CenterScreen" Background="#F6F8FB" UseLayoutRounding="True" FontFamily="Segoe UI">
    <Window.Resources>
        <ResourceDictionary Source="DesktopStyles.xaml" />
    </Window.Resources>
    <TabControl x:Name="Pages" BorderThickness="0" Background="#F6F8FB" Padding="0" Margin="12,10,12,0">
        <TabControl.Resources>
            <Style TargetType="TabItem">
                <Setter Property="Padding" Value="16,5" />
                <Setter Property="FontSize" Value="13" />
            </Style>
        </TabControl.Resources>
        <TabItem x:Name="ReportTab" Header="_Report" />
        <TabItem x:Name="SettingsTab" Header="_Settings" />
    </TabControl>
</Window>
